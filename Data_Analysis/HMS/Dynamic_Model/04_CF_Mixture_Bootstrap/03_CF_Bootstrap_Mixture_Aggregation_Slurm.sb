#!/bin/sh


# --------------------------------------------------------------
# Job Name
# --------------------------------------------------------------

### Optional. Set the job name
#SBATCH --job-name=CF_Bootstrap_Mixture_Agg


# --------------------------------------------------------------
# Output
# --------------------------------------------------------------

### Slurm stdout/stderr - captures Julia startup errors, module load failures, etc.
#SBATCH --output=slurm_%j.out
#SBATCH --error=slurm_%j.err


# --------------------------------------------------------------
# Account and Notifications
# --------------------------------------------------------------

### REQUIRED. Specify the PI group for this job
#SBATCH --account=wildenbeest

### Optional. Request email when job begins and ends
### SBATCH --mail-type=BEGIN,END,FAIL

### Optional. Specify email address to use for notification
#SBATCH --mail-user=wbrasic@arizona.edu


# --------------------------------------------------------------
# Resources
# --------------------------------------------------------------

### REQUIRED. Set the partition for your job.
#SBATCH --partition=standard

### REQUIRED. Run on a single node with a single process.
#SBATCH --nodes=1
#SBATCH --ntasks=1

### REQUIRED. Single CPU for sequential aggregation (no Julia threading needed).
#SBATCH --cpus-per-task=1

### REQUIRED. Memory per core (total = cpus-per-task × mem-per-cpu).
#SBATCH --mem-per-cpu=5gb

### REQUIRED. Specify the time required for this job, hhh:mm:ss
#SBATCH --time=002:00:00


# --------------------------------------------------------------
# Estimation Flags
# --------------------------------------------------------------

# Forward flags to Julia.
# Set at submission time (defaults apply if not provided).
# Flags must match those used when running 02_CF_Mixture_Bootstrap_Slurm.sb.
#
# Flags:
#   ESTIMATE_PSI_3 (default: false)  Load ψ_3-estimated model results (27-param)
#   PSI_3          (default: 0.75)   Fixed ψ_3 value (ignored when ESTIMATE_PSI_3=true)
#   BETA           (default: 1.0)    Present-bias β (must match bootstrap submission)
#   B              (default: 100)    Number of bootstrap draws to aggregate
#
# Usage examples:
#   Default (ψ_3=0.75 fixed, β=1.0, B=100):
#     sbatch 03_CF_Bootstrap_Mixture_Aggregation_Slurm.sb
#
#   Test run aggregating only the first 2 draws:
#     B=2 sbatch 03_CF_Bootstrap_Mixture_Aggregation_Slurm.sb
#
#   With β=0.70:
#     BETA=0.70 sbatch 03_CF_Bootstrap_Mixture_Aggregation_Slurm.sb
#
#   With estimated ψ_3:
#     ESTIMATE_PSI_3=true sbatch 03_CF_Bootstrap_Mixture_Aggregation_Slurm.sb
export ESTIMATE_PSI_3=${ESTIMATE_PSI_3:-false}
export PSI_3=${PSI_3:-0.75}
export BETA=${BETA:-1.0}
export B=${B:-100}


# --------------------------------------------------------------
# Execution
# --------------------------------------------------------------

# Load Julia module
module load julia

# Navigate to the script directory
cd /home/u2/wbrasic/4th_Year_Paper/Dynamic_Model/04_CF_Mixture_V2_Bootstrap

# Run script
julia 03_CF_Bootstrap_Mixture_Aggregation.jl
