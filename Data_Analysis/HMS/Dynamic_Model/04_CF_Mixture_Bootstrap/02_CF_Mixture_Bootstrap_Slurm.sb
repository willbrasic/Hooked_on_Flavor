#!/bin/bash


# --------------------------------------------------------------
# Job Name
# --------------------------------------------------------------

### Optional. Set the job name
#SBATCH --job-name=CF_Bootstrap_Mixture


# --------------------------------------------------------------
# Output
# --------------------------------------------------------------

### Slurm stdout/stderr - captures Julia startup errors, module load failures, etc.
#SBATCH --output=slurm_%A_%a.out
#SBATCH --error=slurm_%A_%a.err


# --------------------------------------------------------------
# Account and Notifications
# --------------------------------------------------------------

### REQUIRED. Specify the PI group for this job
#SBATCH --account=wildenbeest

### Optional. Request email when job begins and ends
### SBATCH --mail-type=BEGIN,END,FAIL

### Optional. Specify email address to use for notification
#SBATCH --mail-user=wbrasic@arizona.edu


# --------------------------------------------------------------
# Resources
# --------------------------------------------------------------

### REQUIRED. Set the partition for your job.
#SBATCH --partition=standard

### REQUIRED. Run on a single node with a single process.
#SBATCH --nodes=1
#SBATCH --ntasks=1

### REQUIRED. Number of CPU cores for Julia threading. 94 is max for Puma and 28 is max for Ocelote
#SBATCH --cpus-per-task=94

### REQUIRED. Memory per core (total = cpus-per-task x mem-per-cpu).
#SBATCH --mem-per-cpu=5gb

### REQUIRED. Specify the time required for this job, hhh:mm:ss
#SBATCH --time=012:00:00

### REQUIRED. Array: one Slurm task per bootstrap draw (b = SLURM_ARRAY_TASK_ID)
#SBATCH --array=68-100


# --------------------------------------------------------------
# Estimation Flags
# --------------------------------------------------------------

# Forward flags to Julia.
# Set at submission time (defaults apply if not provided).
#
# Flags:
#   ESTIMATE_PSI_3 (default: false)  Load ψ_3-estimated model results (27-param)
#   PSI_3          (default: 0.75)   Fixed ψ_3 value (ignored when ESTIMATE_PSI_3=true)
#   BETA           (default: 1.0)    Present-bias β for this bootstrap run
#
# The number of bootstrap draws B is controlled by --array above (currently 1-35).
# To change B, edit the --array directive directly.
#
# Usage examples:
#   Default (ψ_3=0.75 fixed, β=1.0):
#     sbatch 02_CF_Mixture_Bootstrap_Slurm.sb
#
#   With β=0.70:
#     BETA=0.70 sbatch 02_CF_Mixture_Bootstrap_Slurm.sb
#
#   With estimated ψ_3:
#     ESTIMATE_PSI_3=true sbatch 02_CF_Mixture_Bootstrap_Slurm.sb
#
#   Resubmit specific missing draws (e.g. after node failures):
#     sbatch --array=49,50,52,54,55,57,59,61,62,66 02_CF_Mixture_Bootstrap_Slurm.sb
export ESTIMATE_PSI_3=${ESTIMATE_PSI_3:-false}
export PSI_3=${PSI_3:-0.75}
export BETA=${BETA:-1.0}


# --------------------------------------------------------------
# Execution
# --------------------------------------------------------------

# Initialize the module system (required on nodes that start with a clean environment)
source /etc/profile.d/lmod.sh

# Load Julia module
module load julia

# Set Julia threads for VFI parallelization over price states
export JULIA_NUM_THREADS=$SLURM_CPUS_PER_TASK

# Navigate to the script directory
cd /home/u2/wbrasic/4th_Year_Paper/Dynamic_Model/04_CF_Mixture_V2_Bootstrap

# Run bootstrap script (SLURM_ARRAY_TASK_ID is the bootstrap draw index b)
julia 02_CF_Mixture_Bootstrap.jl
